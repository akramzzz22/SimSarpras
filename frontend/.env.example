# ============================================================
# Konfigurasi Frontend (Nuxt)
# Salin file ini menjadi `.env` lalu sesuaikan.
# ============================================================

# Mode HTTPS dev server.
#   true  (default) → https://192.168.0.2:3000 (kamera scan QR jalan dari HP via IP LAN)
#   false           → http://192.168.0.2:3000  (kamera hanya jalan di http://localhost)
NUXT_HTTPS=true

# Base URL API. Default '/api' diproxy Nuxt ke backend (http://localhost:8000/api).
# Set ini jika backend di host/port lain, mis. http://10.0.0.5:8000/api
# NUXT_PUBLIC_API_BASE=/api

# Base URL aplikasi yang dibakar ke dalam QR code barang.
# NUXT_PUBLIC_APP_BASE=https://192.168.0.2:3000
